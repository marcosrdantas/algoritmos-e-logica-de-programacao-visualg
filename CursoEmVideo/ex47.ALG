algoritmo "semnome"

var
soma, contador, valorFinal: inteiro

inicio
soma <- 0
contador <- 500
valorFinal <- 0

enquanto contador >= valorFinal faca
         soma <- soma + contador
         escreva(contador)
         contador <- contador - 50
fimenquanto
escreval()

escreval()
escreval("A soma de todos os numeros dessa sequencia [0-500] e:", soma)

fimalgoritmo