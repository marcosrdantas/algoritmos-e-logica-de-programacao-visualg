algoritmo "semnome"

var
   n1: real
   n2: real
   n3: real
   
inicio
   escreva("Digite um número: ")
   leia(n1)
   escreval()
   
   n2 <- n1 * 2
   n3 <- n1 / 3
   
   escreval("O número que você escolheu foi:", n1)
   escreval()
   
   escreval("O dobro de", n1, " é:", n2)
   escreval("A terça parte de", n1, " é:", n3)
fimalgoritmo