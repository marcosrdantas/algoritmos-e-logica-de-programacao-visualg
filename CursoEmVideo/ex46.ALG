algoritmo "semnome"

var
soma, contador, valorFinal: inteiro

inicio
soma <- 0
contador <- 6
valorFinal <- 100

enquanto contador <= valorFinal faca
         soma <- soma + contador
         escreva(contador)
         contador <- contador + 2
fimenquanto
escreval()

escreval()
escreval("A soma de todos os numeros dessa sequencia [6-100] e:", soma)
fimalgoritmo