algoritmo "semnome"

var

   hora, aulas: inteiro

inicio
      escreval("PRESENÇA LABORATÓRIO")
      escreval()
      
      escreva("Digite quantas horas você participou nos laboratórios: ")
      leia(hora)
      escreval()
      
      aulas <- hora\4
      
      escreval("Você tem um total de ", aulas, " presenças nessa disciplina")

fimalgoritmo